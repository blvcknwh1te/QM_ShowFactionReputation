# Сборки
**/bin/
**/obj/

# Dev scratch (если появится локально в папке мода)
_dev/temp/
_dev/decompiled/
_dev/backups/

# Игровые DLL — локальные копии (не коммитить; структура через .gitkeep)
libs/game/*
