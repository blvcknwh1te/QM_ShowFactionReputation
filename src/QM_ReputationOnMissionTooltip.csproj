<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ReputationOnMissionTooltip</RootNamespace>
    <AssemblyName>QM_ReputationOnMissionTooltip</AssemblyName>
    <OutputType>Library</OutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\</RepoRoot>
    <WorkspaceRoot>$(RepoRoot)..\</WorkspaceRoot>
    <GameLibs>$(WorkspaceRoot)libs\game\</GameLibs>
    <PublicizedLibs>$(WorkspaceRoot)libs\publicized\</PublicizedLibs>
    <PackageDir>$(RepoRoot)package\</PackageDir>
    <!-- Только для справки / steam vdf; в игру идёт облако Workshop, не копируем сюда из build -->
    <SteamId>3790325906</SteamId>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameLibs)0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(PublicizedLibs)Assembly-CSharp-publicized.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameLibs)UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameLibs)UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameLibs)UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameLibs)Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- SSOT для игры = Steam Workshop. Build кладёт артефакты только в package\ → дальше SteamCMD. -->
  <Target Name="CopyToPackage" AfterTargets="Build">
    <ItemGroup>
      <_ModDeploy Include="$(TargetPath)" />
      <_ModDeploy Include="$(RepoRoot)modmanifest.json" />
      <_ModDeploy Include="$(RepoRoot)media\thumbnail.png" Condition="Exists('$(RepoRoot)media\thumbnail.png')" />
    </ItemGroup>
    <MakeDir Directories="$(PackageDir)" />
    <Copy SourceFiles="@(_ModDeploy)" DestinationFolder="$(PackageDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
